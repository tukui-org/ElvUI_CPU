<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.blizzard.com/wow/ui/ https://raw.githubusercontent.com/Meorawr/wow-ui-schema/main/UI.xsd">
	<Button name="ElvUICpuToolbarButtonTemplate" virtual="true">
		<Size x="72" y="20" />
		<Layers>
			<Layer level="BACKGROUND">
				<Texture parentKey="NormalTexture" atlas="auctionhouse-nav-button" useAtlasSize="false">
					<Anchors>
						<Anchor point="TOPLEFT" x="-2" y="0" />
						<Anchor point="BOTTOMRIGHT" x="2" y="-12" />
					</Anchors>
				</Texture>
			</Layer>
			<Layer level="OVERLAY">
				<Texture parentKey="MouseoverOverlay" hidden="true" atlas="auctionhouse-nav-button"
					useAtlasSize="false" alphaMode="ADD">
					<Anchors>
						<Anchor point="TOPLEFT" relativeKey="$parent.NormalTexture" />
						<Anchor point="BOTTOMRIGHT" relativeKey="$parent.NormalTexture" />
					</Anchors>
				</Texture>
			</Layer>
		</Layers>
		<ButtonText parentKey="Text">
			<Anchors>
				<Anchor point="CENTER" />
			</Anchors>
		</ButtonText>
		<NormalFont style="GameFontHighlight" />
		<HighlightFont style="GameFontHighlight" />
		<DisabledFont style="GameFontDisable" />
	</Button>

	<CheckButton name="ElvUICpuCheckButtonTemplate" inherits="UICheckButtonArtTemplate" virtual="true">
		<Size x="32" y="32" />
		<Layers>
			<Layer level="ARTWORK">
				<FontString parentKey="Text" inherits="GameFontHighlightSmall">
					<Anchors>
						<Anchor point="LEFT" relativePoint="RIGHT" x="-2" />
					</Anchors>
					<Color r="1" g="1" b="1" />
				</FontString>
			</Layer>
		</Layers>
	</CheckButton>

	<Frame name="ElvUICpuCellTemplate" virtual="true" clipChildren="true">
		<Layers>
			<Layer level="OVERLAY">
				<FontString parentKey="Text" inherits="GameFontHighlightSmall" wordwrap="false">
					<Size y="20" />
					<Anchors>
						<Anchor point="LEFT" x="6" />
						<Anchor point="RIGHT" x="-4" />
					</Anchors>
				</FontString>
			</Layer>
		</Layers>
	</Frame>

	<Button name="ElvUICpuColumnGripTemplate" mixin="ElvUICpuColumnGripMixin" virtual="true">
		<Size x="8" y="18" />
		<Anchors>
			<Anchor point="RIGHT" x="-1" />
		</Anchors>
		<Layers>
			<Layer level="OVERLAY">
				<Texture parentKey="Line" file="Interface\Buttons\WHITE8X8">
					<Size x="2" />
					<Anchors>
						<Anchor point="TOP" y="-2" />
						<Anchor point="BOTTOM" y="2" />
					</Anchors>
					<Color r="1" g="1" b="1" a="0.45" />
				</Texture>
			</Layer>
		</Layers>
		<Scripts>
			<OnEnter method="OnEnter" />
			<OnLeave method="OnLeave" />
			<OnMouseDown method="OnMouseDown" />
		</Scripts>
	</Button>

	<Button name="ElvUICpuRowTemplate" mixin="ElvUICpuRowMixin" virtual="true">
		<Size y="20" />
		<Frames>
			<Frame parentKey="Cell1" inherits="ElvUICpuCellTemplate" />
			<Frame parentKey="Cell2" inherits="ElvUICpuCellTemplate" />
			<Frame parentKey="Cell3" inherits="ElvUICpuCellTemplate" />
			<Frame parentKey="Cell4" inherits="ElvUICpuCellTemplate" />
			<Frame parentKey="Cell5" inherits="ElvUICpuCellTemplate" />
			<Frame parentKey="Cell6" inherits="ElvUICpuCellTemplate" />
			<Frame parentKey="Cell7" inherits="ElvUICpuCellTemplate" />
			<Frame parentKey="Cell8" inherits="ElvUICpuCellTemplate" />
			<Frame parentKey="Cell9" inherits="ElvUICpuCellTemplate" />
			<Frame parentKey="Cell10" inherits="ElvUICpuCellTemplate" />
			<Frame parentKey="Cell11" inherits="ElvUICpuCellTemplate" />
		</Frames>
		<Layers>
			<Layer level="BACKGROUND">
				<Texture parentKey="Alternate" hidden="true" alphaMode="ADD" file="Interface\Buttons\WHITE8X8">
					<Anchors>
						<Anchor point="TOPLEFT" />
						<Anchor point="BOTTOMRIGHT" />
					</Anchors>
					<Color r="1" g="1" b="1" a="0.05" />
				</Texture>
			</Layer>
		</Layers>
		<HighlightTexture file="Interface\Buttons\WHITE8X8" alphaMode="ADD">
			<Anchors>
				<Anchor point="TOPLEFT" />
				<Anchor point="BOTTOMRIGHT" />
			</Anchors>
			<Color r="1" g="1" b="1" a="0.12" />
		</HighlightTexture>
		<Scripts>
			<OnLoad method="OnLoad" />
			<OnMouseUp method="OnMouseUp" />
		</Scripts>
	</Button>

	<Frame name="ElvUI_CPUFrame" mixin="ElvUICpuPanelMixin" inherits="ButtonFrameTemplate"
		parent="ElvUIParent" toplevel="true" movable="true" resizable="true" enableMouse="true"
		hidden="true" frameStrata="HIGH">
		<Size x="900" y="520" />
		<Anchors>
			<Anchor point="CENTER" />
		</Anchors>
		<Frames>
			<Frame parentKey="TitleBar" inherits="PanelDragBarTemplate">
				<Size y="32" />
				<Anchors>
					<Anchor point="TOPLEFT" />
					<Anchor point="TOPRIGHT" />
				</Anchors>
			</Frame>
			<Button parentKey="ResizeButton" inherits="PanelResizeButtonTemplate">
				<Anchors>
					<Anchor point="BOTTOMRIGHT" x="-4" y="4" />
				</Anchors>
			</Button>
			<Frame parentKey="Toolbar">
				<Size y="36" />
				<Anchors>
					<Anchor point="TOPLEFT" x="12" y="-30" />
					<Anchor point="TOPRIGHT" x="-12" y="-30" />
				</Anchors>
				<Frames>
					<Button parentKey="PlayButton" inherits="ElvUICpuToolbarButtonTemplate" text="Play">
						<Size x="84" y="20" />
						<Anchors>
							<Anchor point="TOPLEFT" y="-2" />
						</Anchors>
						<KeyValues>
							<KeyValue key="tooltipText"
								value="Starts or stops the one-second list refresh. Measuring continues either way."
								type="string" />
						</KeyValues>
					</Button>
					<Button parentKey="RefreshButton" inherits="ElvUICpuToolbarButtonTemplate" text="Refresh">
						<Size x="96" y="20" />
						<Anchors>
							<Anchor point="TOPLEFT" relativeKey="$parent.PlayButton" relativePoint="TOPRIGHT" x="6" />
						</Anchors>
						<KeyValues>
							<KeyValue key="tooltipText" value="Updates the visible rows once."
								type="string" />
						</KeyValues>
					</Button>
					<Button parentKey="ResetButton" inherits="ElvUICpuToolbarButtonTemplate" text="Reset">
						<Size x="84" y="20" />
						<Anchors>
							<Anchor point="TOPLEFT" relativeKey="$parent.RefreshButton" relativePoint="TOPRIGHT" x="6" />
						</Anchors>
						<KeyValues>
							<KeyValue key="tooltipText"
								value="Zeros call counts, times, and byte totals collected since the window loaded."
								type="string" />
						</KeyValues>
					</Button>
					<Button parentKey="ProfileButton" inherits="ElvUICpuToolbarButtonTemplate" text="Profile">
						<Size x="108" y="20" />
						<Anchors>
							<Anchor point="TOPLEFT" relativeKey="$parent.ResetButton" relativePoint="TOPRIGHT" x="6" />
						</Anchors>
						<KeyValues>
							<KeyValue key="tooltipText"
								value="Toggles CPU profiling and reloads the UI."
								type="string" />
						</KeyValues>
					</Button>
					<CheckButton parentKey="MicrosecondsCheck" inherits="ElvUICpuCheckButtonTemplate">
						<Anchors>
							<Anchor point="LEFT" relativeKey="$parent.ProfileButton" relativePoint="RIGHT" x="6" y="0" />
						</Anchors>
					</CheckButton>
					<EditBox parentKey="SearchBox" autoFocus="false" historyLines="1" bytes="256"
						inherits="SearchBoxTemplate">
						<Size x="220" y="22" />
						<Anchors>
							<Anchor point="RIGHT" />
						</Anchors>
						<KeyValues>
							<KeyValue key="instructionText" value="Function name" type="string" />
							<KeyValue key="tooltipText"
								value="Filters the list to method names that contain this text."
								type="string" />
						</KeyValues>
					</EditBox>
				</Frames>
			</Frame>
			<Frame parentKey="Columns" inherits="ColumnDisplayTemplate">
				<Size y="24" />
				<Anchors>
					<Anchor point="TOPLEFT" relativeKey="$parent.Toolbar" relativePoint="BOTTOMLEFT"
						y="-4" />
					<Anchor point="TOPRIGHT" relativeKey="$parent.Toolbar"
						relativePoint="BOTTOMRIGHT" x="-25" y="-4" />
				</Anchors>
			</Frame>
			<Button parentKey="FooterButton">
				<Size y="36" />
				<Anchors>
					<Anchor point="BOTTOMLEFT" x="12" y="6" />
					<Anchor point="BOTTOMRIGHT" x="-140" y="6" />
				</Anchors>
				<Layers>
					<Layer level="OVERLAY">
						<FontString parentKey="Text" inherits="GameFontHighlightSmall" justifyH="LEFT" wordwrap="true">
							<Anchors>
								<Anchor point="TOPLEFT" x="2" y="-2" />
								<Anchor point="BOTTOMRIGHT" x="-2" y="2" />
							</Anchors>
						</FontString>
					</Layer>
				</Layers>
			</Button>
			<EventFrame parentKey="HorizontalScrollBar" inherits="WowTrimHorizontalScrollBar"
				hidden="true">
				<Anchors>
					<Anchor point="BOTTOMLEFT" relativeKey="$parent.FooterButton" relativePoint="TOPLEFT"
						y="4" />
					<Anchor point="BOTTOMRIGHT" relativeKey="$parent.FooterButton" relativePoint="TOPRIGHT"
						x="103" y="4" />
				</Anchors>
			</EventFrame>
			<Frame parentKey="ScrollBox" inherits="WowScrollBoxList">
				<Anchors>
					<Anchor point="TOPLEFT" relativeKey="$parent.Columns" relativePoint="BOTTOMLEFT"
						y="-2" />
					<Anchor point="BOTTOMRIGHT" relativeKey="$parent.FooterButton" relativePoint="TOPRIGHT"
						x="103" y="8" />
				</Anchors>
				<Layers>
					<Layer level="BACKGROUND">
						<Texture file="Interface\Buttons\WHITE8X8">
							<Color r="0.03" g="0.03" b="0.03" a="1" />
						</Texture>
					</Layer>
				</Layers>
			</Frame>
			<EventFrame parentKey="ScrollBar" inherits="MinimalScrollBar">
				<Anchors>
					<Anchor point="TOPLEFT" relativeKey="$parent.ScrollBox" relativePoint="TOPRIGHT"
						x="6" y="-4" />
					<Anchor point="BOTTOMLEFT" relativeKey="$parent.ScrollBox"
						relativePoint="BOTTOMRIGHT" x="6" y="4" />
				</Anchors>
			</EventFrame>
			<Frame parentKey="FooterDialog" hidden="true" frameStrata="DIALOG" toplevel="true"
				enableMouse="true">
				<Size x="520" y="292" />
				<Anchors>
					<Anchor point="CENTER" />
				</Anchors>
				<Layers>
					<Layer level="OVERLAY">
						<FontString parentKey="Title" inherits="GameFontHighlight" text="Footer stats">
							<Anchors>
								<Anchor point="TOP" y="-14" />
							</Anchors>
							<Color r="1" g="1" b="1" />
						</FontString>
						<FontString parentKey="Note" inherits="GameFontDisableSmall"
							text="Tick times are ElvUI's own cost, from C_AddOnProfiler.GetAddOnMetric.">
							<Anchors>
								<Anchor point="BOTTOM" y="14" />
							</Anchors>
						</FontString>
					</Layer>
				</Layers>
				<Frames>
					<CheckButton parentKey="functionCount" inherits="ElvUICpuCheckButtonTemplate">
						<Anchors>
							<Anchor point="TOPLEFT" x="16" y="-36" />
						</Anchors>
						<KeyValues>
							<KeyValue key="footerMetricKey" value="functionCount" type="string" />
						</KeyValues>
					</CheckButton>
					<CheckButton parentKey="lastTime" inherits="ElvUICpuCheckButtonTemplate">
						<Anchors>
							<Anchor point="TOPLEFT" relativeKey="$parent.functionCount" relativePoint="BOTTOMLEFT"
								y="2" />
						</Anchors>
						<KeyValues>
							<KeyValue key="footerMetricKey" value="lastTime" type="string" />
						</KeyValues>
					</CheckButton>
					<CheckButton parentKey="recentAverageTime" inherits="ElvUICpuCheckButtonTemplate">
						<Anchors>
							<Anchor point="TOPLEFT" relativeKey="$parent.lastTime" relativePoint="BOTTOMLEFT"
								y="2" />
						</Anchors>
						<KeyValues>
							<KeyValue key="footerMetricKey" value="recentAverageTime" type="string" />
						</KeyValues>
					</CheckButton>
					<CheckButton parentKey="peakTime" inherits="ElvUICpuCheckButtonTemplate">
						<Anchors>
							<Anchor point="TOPLEFT" relativeKey="$parent.recentAverageTime" relativePoint="BOTTOMLEFT"
								y="2" />
						</Anchors>
						<KeyValues>
							<KeyValue key="footerMetricKey" value="peakTime" type="string" />
						</KeyValues>
					</CheckButton>
					<CheckButton parentKey="sessionAverageTime" inherits="ElvUICpuCheckButtonTemplate">
						<Anchors>
							<Anchor point="TOPLEFT" relativeKey="$parent.peakTime" relativePoint="BOTTOMLEFT"
								y="2" />
						</Anchors>
						<KeyValues>
							<KeyValue key="footerMetricKey" value="sessionAverageTime" type="string" />
						</KeyValues>
					</CheckButton>
					<CheckButton parentKey="encounterAverageTime" inherits="ElvUICpuCheckButtonTemplate">
						<Anchors>
							<Anchor point="TOPLEFT" relativeKey="$parent.sessionAverageTime"
								relativePoint="BOTTOMLEFT" y="2" />
						</Anchors>
						<KeyValues>
							<KeyValue key="footerMetricKey" value="encounterAverageTime" type="string" />
						</KeyValues>
					</CheckButton>
					<CheckButton parentKey="over1Ms" inherits="ElvUICpuCheckButtonTemplate">
						<Anchors>
							<Anchor point="TOPLEFT" x="270" y="-36" />
						</Anchors>
						<KeyValues>
							<KeyValue key="footerMetricKey" value="over1Ms" type="string" />
						</KeyValues>
					</CheckButton>
					<CheckButton parentKey="over5Ms" inherits="ElvUICpuCheckButtonTemplate">
						<Anchors>
							<Anchor point="TOPLEFT" relativeKey="$parent.over1Ms" relativePoint="BOTTOMLEFT"
								y="2" />
						</Anchors>
						<KeyValues>
							<KeyValue key="footerMetricKey" value="over5Ms" type="string" />
						</KeyValues>
					</CheckButton>
					<CheckButton parentKey="over10Ms" inherits="ElvUICpuCheckButtonTemplate">
						<Anchors>
							<Anchor point="TOPLEFT" relativeKey="$parent.over5Ms" relativePoint="BOTTOMLEFT"
								y="2" />
						</Anchors>
						<KeyValues>
							<KeyValue key="footerMetricKey" value="over10Ms" type="string" />
						</KeyValues>
					</CheckButton>
					<CheckButton parentKey="over50Ms" inherits="ElvUICpuCheckButtonTemplate">
						<Anchors>
							<Anchor point="TOPLEFT" relativeKey="$parent.over10Ms" relativePoint="BOTTOMLEFT"
								y="2" />
						</Anchors>
						<KeyValues>
							<KeyValue key="footerMetricKey" value="over50Ms" type="string" />
						</KeyValues>
					</CheckButton>
					<CheckButton parentKey="over100Ms" inherits="ElvUICpuCheckButtonTemplate">
						<Anchors>
							<Anchor point="TOPLEFT" relativeKey="$parent.over50Ms" relativePoint="BOTTOMLEFT"
								y="2" />
						</Anchors>
						<KeyValues>
							<KeyValue key="footerMetricKey" value="over100Ms" type="string" />
						</KeyValues>
					</CheckButton>
					<CheckButton parentKey="over500Ms" inherits="ElvUICpuCheckButtonTemplate">
						<Anchors>
							<Anchor point="TOPLEFT" relativeKey="$parent.over100Ms" relativePoint="BOTTOMLEFT"
								y="2" />
						</Anchors>
						<KeyValues>
							<KeyValue key="footerMetricKey" value="over500Ms" type="string" />
						</KeyValues>
					</CheckButton>
					<CheckButton parentKey="over1000Ms" inherits="ElvUICpuCheckButtonTemplate">
						<Anchors>
							<Anchor point="TOPLEFT" relativeKey="$parent.over500Ms" relativePoint="BOTTOMLEFT"
								y="2" />
						</Anchors>
						<KeyValues>
							<KeyValue key="footerMetricKey" value="over1000Ms" type="string" />
						</KeyValues>
					</CheckButton>
				</Frames>
			</Frame>
		</Frames>
		<Layers>
			<Layer level="OVERLAY">
				<FontString parentKey="Version" inherits="GameFontDisableSmall" justifyH="RIGHT">
					<Anchors>
						<Anchor point="BOTTOMRIGHT" x="-28" y="8" />
					</Anchors>
				</FontString>
			</Layer>
		</Layers>
		<Scripts>
			<OnLoad method="OnLoad" />
			<OnShow method="OnShow" />
		</Scripts>
	</Frame>

	<Frame name="ElvUI_CPUPeakCallStackDialog" mixin="ElvUICpuPeakCallStackMixin" parent="ElvUIParent"
		hidden="true" movable="true" resizable="true" clampedToScreen="true" frameStrata="DIALOG"
		toplevel="true" enableMouse="true">
		<Size x="960" y="520" />
		<Anchors>
			<Anchor point="CENTER" />
		</Anchors>
		<Layers>
			<Layer level="OVERLAY">
				<FontString parentKey="Title" inherits="GameFontNormal" text="Slowest call stack">
					<Anchors>
						<Anchor point="TOP" y="-14" />
					</Anchors>
				</FontString>
			</Layer>
		</Layers>
		<Frames>
			<ScrollFrame parentKey="ScrollFrame" inherits="InputScrollFrameTemplate">
				<Anchors>
					<Anchor point="TOPLEFT" x="16" y="-40" />
					<Anchor point="BOTTOMRIGHT" x="-36" y="16" />
				</Anchors>
			</ScrollFrame>
			<Button parentKey="ResizeButton" inherits="PanelResizeButtonTemplate">
				<Anchors>
					<Anchor point="BOTTOMRIGHT" x="-4" y="4" />
				</Anchors>
			</Button>
		</Frames>
		<Scripts>
			<OnLoad method="OnLoad" />
			<OnDragStart method="OnDragStart" />
			<OnDragStop method="OnDragStop" />
			<OnSizeChanged method="OnSizeChanged" />
		</Scripts>
	</Frame>
</Ui>